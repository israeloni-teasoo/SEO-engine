# --- Claude AI (for smart suggestions & auto-fix) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for suggestions/auto-fix (default: claude-opus-5)
SEO_AI_MODEL=claude-opus-5

# --- WordPress publishing (optional defaults; can also be entered in the UI) ---
# Your site URL, e.g. https://blog.example.com  (no trailing slash needed)
WORDPRESS_URL=
# The WordPress username that owns the Application Password
WORDPRESS_USERNAME=
# An Application Password: WP Admin -> Users -> Profile -> Application Passwords
# (spaces are fine; they are stripped automatically)
WORDPRESS_APP_PASSWORD=

# --- Site config used by the analyzer ---
# Used to classify internal vs. external links (e.g. example.com)
SITE_DOMAIN=
