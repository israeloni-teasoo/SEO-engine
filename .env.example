# ============================================================================
#  SEO Engine — environment variables
#  Copy to .env.local for local dev, or set these in Vercel Project Settings.
# ============================================================================

# --- Claude AI (suggestions, auto-fix, alt text, LinkedIn drafting) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default: claude-opus-5)
SEO_AI_MODEL=claude-opus-5

# ============================================================================
#  MULTI-USER MODE (optional). Set AUTH_SECRET *and* DATABASE_URL together to
#  turn on staff accounts, roles, and the approval workflow. Leave both unset
#  to run the original single-user app (no login).
# ============================================================================
# Postgres/Neon connection string. Create a DB at https://neon.tech (free tier).
DATABASE_URL=
# Long random string used to sign session cookies. Generate: openssl rand -hex 32
AUTH_SECRET=
# Long random string used to encrypt stored credentials. openssl rand -hex 32
ENCRYPTION_KEY=
# Emails that should be admins on first sign-in (comma-separated). The very
# first account created is also made an admin automatically.
ADMIN_EMAILS=tech.teasooconsulting@gmail.com
# Optional: restrict sign-up to your company email domain (e.g. teasoo.com).
ALLOWED_EMAIL_DOMAIN=

# --- Google sign-in (optional; part of multi-user mode) ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in Google Cloud.
# Defaults to <your-domain>/api/auth/google/callback if unset.
GOOGLE_REDIRECT_URI=
# Optional: hint/restrict Google sign-in to a Workspace domain.
GOOGLE_ALLOWED_DOMAIN=

# --- Site config used by the analyzer ---
# Used to classify internal vs. external links (e.g. example.com)
SITE_DOMAIN=

# --- WordPress publishing (optional defaults; can also be entered in the UI) ---
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- IndexNow (instant indexing on Bing/Yandex/etc.; Google uses sitemaps) ---
# A random hex string, 8-128 chars. Host <INDEXNOW_KEY>.txt at your blog's root.
INDEXNOW_KEY=
# Optional: override the host used for submissions (defaults to the published URL's host)
INDEXNOW_HOST=

# --- LinkedIn (OAuth + posting) ---
# Create an app at https://www.linkedin.com/developers/apps  (see SETUP.md)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the Authorized redirect URL in your LinkedIn app.
# Defaults to <your-domain>/api/linkedin/callback if unset.
LINKEDIN_REDIRECT_URI=
# OAuth scopes. Personal posting: "openid profile w_member_social".
# Company page posting also needs "w_organization_social" (requires app review).
LINKEDIN_SCOPES=openid profile w_member_social
# LinkedIn API version header (YYYYMM). Bump periodically.
LINKEDIN_API_VERSION=202508
# Your LinkedIn company page numeric ID (for posting to the company page).
LINKEDIN_ORG_ID=
